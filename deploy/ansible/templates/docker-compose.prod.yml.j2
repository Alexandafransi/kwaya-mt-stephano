# Rendered by Ansible — do not edit on the server, changes will be overwritten.
services:
  web:
    image: ${IMAGE}
    restart: unless-stopped
    # Loopback only, for the deploy health check; public traffic arrives
    # through Traefik on the proxy network.
    ports:
      - "127.0.0.1:3020:3000"
    networks:
      - proxy
    labels:
      - traefik.enable=true
      # Only the apex host: there is no www.{{ app_domain }} DNS record, and
      # including it made Let's Encrypt fail the HTTP-01 challenge for that
      # name, which blocked the certificate for the whole router.
      - traefik.http.routers.kwaya-app.rule=Host(`{{ app_domain }}`)
      - traefik.http.routers.kwaya-app.entrypoints=websecure
      - traefik.http.routers.kwaya-app.tls.certresolver=letsencrypt
      - traefik.http.services.kwaya-app.loadbalancer.server.port=3000

networks:
  proxy:
    external: true
